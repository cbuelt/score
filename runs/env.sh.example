# Machine-specific environment for the SLURM scripts in runs/. Copy to
# runs/env.sh (git-ignored); every script sources it if it exists.
#
# Activate the Python environment, e.g.
#   source "$(conda info --base)/etc/profile.d/conda.sh"
#   conda activate score
#
# Folder holding synced checkpoints (<experiment>/<dataset>/.../<slug>/seed<N>/),
# read by runs/calibration.sh.
# export SHARED=/path/to/results
#
# ERA5 store and training-period normalization statistics, used by
# runs/calibration.sh to rebuild the ERA5 datamodule.
# export ERA5_DATA=/path/to/era5/
# export ERA5_STATS=/path/to/era5_statistics_train1990-2014.npy
